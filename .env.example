# ---------------------------------------------------------------------------
# PHISHGUARD environment template
#
# Copy this file to `.env` and replace every placeholder. `.env` is gitignored.
#
# Rules:
#   * Never commit a filled-in `.env`.
#   * Never reuse a real credential value in this file, not even one that is
#     already revoked, and not even one that looks harmless.
#   * Use distinct values per environment.
#   * On Linux or macOS, generate secret values with: openssl rand -hex 32
#
# Nothing in this file is a working credential.
# ---------------------------------------------------------------------------

# --- Runtime ----------------------------------------------------------------
# One of: development, test, staging, production.
PHISHGUARD_ENVIRONMENT=development
PHISHGUARD_LOG_LEVEL=INFO

# --- HTTP API ---------------------------------------------------------------
PHISHGUARD_API_HOST=127.0.0.1
PHISHGUARD_API_PORT=8000
# JSON array format is required here: pydantic-settings parses list fields
# from the environment as JSON, not as comma-separated values.
PHISHGUARD_CORS_ORIGINS=["http://localhost:5173"]

# Hard ceiling for an uploaded message, in bytes. 10485760 = 10 MiB.
PHISHGUARD_MAX_UPLOAD_BYTES=10485760

# --- Database ---------------------------------------------------------------
# The PHISHGUARD PostgreSQL service defined in docker-compose.yml.
# Port 5434 is deliberate: 5432 is a native PostgreSQL install and 5433 is
# another project's container, so this project stays off both.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_DB=phishguard
POSTGRES_USER=phishguard
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=replace-me-before-first-run

# Async driver, used by the application.
DATABASE_URL=postgresql+asyncpg://phishguard:replace-me-before-first-run@127.0.0.1:5434/phishguard

# Synchronous driver, used by Alembic. The migration runner is synchronous.
DATABASE_URL_SYNC=postgresql+psycopg://phishguard:replace-me-before-first-run@127.0.0.1:5434/phishguard

# URL Alembic uses. Falls back to DATABASE_URL_SYNC when unset.
ALEMBIC_DATABASE_URL=postgresql+psycopg://phishguard:replace-me-before-first-run@127.0.0.1:5434/phishguard

# Database used by the integration test suite. It must live on the same
# PHISHGUARD instance and must never be the development database.
POSTGRES_TEST_DB=phishguard_test
DATABASE_URL_TEST=postgresql+asyncpg://phishguard:replace-me-before-first-run@127.0.0.1:5434/phishguard_test

# --- Queue and cache --------------------------------------------------------
# Not used in Milestone 2.2. Redis is intentionally not deployed yet.
# REDIS_URL=redis://localhost:6379/0

# --- Application secrets ----------------------------------------------------
# Signs sessions and other application-level material. Generate a fresh value
# per environment; never reuse the development value anywhere else.
PHISHGUARD_SECRET_KEY=replace-me-with-a-generated-value

# --- Threat intelligence providers -----------------------------------------
# Obtain each key from the provider's own dashboard. Any key left as-is
# disables that adapter; the scoring engine must degrade gracefully when a
# provider is unavailable.
PHISHGUARD_INTEL_VIRUSTOTAL_KEY=replace-with-provider-key
PHISHGUARD_INTEL_URLSCAN_KEY=replace-with-provider-key
PHISHGUARD_INTEL_ABUSEIPDB_KEY=replace-with-provider-key

# Outbound request policy for intelligence adapters.
PHISHGUARD_INTEL_TIMEOUT_SECONDS=10
PHISHGUARD_INTEL_MAX_RESPONSE_BYTES=1048576

# --- AI investigation agent -------------------------------------------------
PHISHGUARD_AGENT_PROVIDER=replace-with-provider-name
PHISHGUARD_AGENT_API_KEY=replace-with-provider-key
PHISHGUARD_AGENT_MODEL=replace-with-model-name

# Upper bound on agent steps per investigation. Guards against runaway loops.
PHISHGUARD_AGENT_MAX_STEPS=12

# --- Frontend (Vite) --------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
